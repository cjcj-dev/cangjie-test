/*
  @Name:        04_23_a27_073

  @Level:         1

  @Assertion:   4.23(27) 3. The return type of the overloaded operator needs to be the same as or a subtype of the left
                operand, i.e., as for a, b, op in the expression a op=b, they need to pass the type check of
                a = a op b.
  @Description: Checks that if overloaded operator op for type L with argument type T
                has return type CL, which is a subtype of L,
                then compound assignment operator op= can be used with types L and T.
  @Mode: run
  @Negative: no
  @Structure: single
  @CompileWarning: no
  @Comment: Auto-generated by gen.py

*/

interface I {}

interface J <: I {}

interface K <: J {}

interface L <: I {
    operator func +(x : Unit) : CL
    operator func -(x : Unit) : CL
    operator func *(x : Unit) : CL
    operator func **(x : Unit) : CL
    operator func /(x : Unit) : CL
    operator func %(x : Unit) : CL
    operator func &(x : Unit) : CL
    operator func |(x : Unit) : CL
    operator func ^(x : Unit) : CL
    operator func <<(x : Unit) : CL
    operator func >>(x : Unit) : CL
}

open class CI <: I {
    public operator func +(_ : Unit) { CL() }
    public operator func -(_ : Unit) { CL() }
    public operator func *(_ : Unit) { CL() }
    public operator func **(_ : Unit) { CL() }
    public operator func /(_ : Unit) { CL() }
    public operator func %(_ : Unit) { CL() }
    public operator func &(_ : Unit) { CL() }
    public operator func |(_ : Unit) { CL() }
    public operator func ^(_ : Unit) { CL() }
    public operator func <<(_ : Unit) { CL() }
    public operator func >>(_ : Unit) { CL() }
}

open class CJ <: J {
    public operator func +(_ : Unit) { CL() }
    public operator func -(_ : Unit) { CL() }
    public operator func *(_ : Unit) { CL() }
    public operator func **(_ : Unit) { CL() }
    public operator func /(_ : Unit) { CL() }
    public operator func %(_ : Unit) { CL() }
    public operator func &(_ : Unit) { CL() }
    public operator func |(_ : Unit) { CL() }
    public operator func ^(_ : Unit) { CL() }
    public operator func <<(_ : Unit) { CL() }
    public operator func >>(_ : Unit) { CL() }
}

open class CK <: K {
    public operator func +(_ : Unit) { CL() }
    public operator func -(_ : Unit) { CL() }
    public operator func *(_ : Unit) { CL() }
    public operator func **(_ : Unit) { CL() }
    public operator func /(_ : Unit) { CL() }
    public operator func %(_ : Unit) { CL() }
    public operator func &(_ : Unit) { CL() }
    public operator func |(_ : Unit) { CL() }
    public operator func ^(_ : Unit) { CL() }
    public operator func <<(_ : Unit) { CL() }
    public operator func >>(_ : Unit) { CL() }
}

open class CL <: L {
    public operator func +(_ : Unit) { CL() }
    public operator func -(_ : Unit) { CL() }
    public operator func *(_ : Unit) { CL() }
    public operator func **(_ : Unit) { CL() }
    public operator func /(_ : Unit) { CL() }
    public operator func %(_ : Unit) { CL() }
    public operator func &(_ : Unit) { CL() }
    public operator func |(_ : Unit) { CL() }
    public operator func ^(_ : Unit) { CL() }
    public operator func <<(_ : Unit) { CL() }
    public operator func >>(_ : Unit) { CL() }
    static func l() : L { CL() }
}

main() {
    var a = CL.l()
    a += ()
    a -= ()
    a *= ()
    a **= ()
    a /= ()
    a %= ()
    a &= ()
    a |= ()
    a ^= ()
    a <<= ()
    a >>= ()

    // Ordinary binary results fit L even though the concrete receivers cannot accept them back.
    let ci = CI()
    let cj = CJ()
    let ck = CK()
    let binaryResults: Array<L> = [
        ci + (), ci - (), ci * (), ci ** (), ci / (), ci % (),
        ci & (), ci | (), ci ^ (), ci << (), ci >> (),
        cj + (), cj - (), cj * (), cj ** (), cj / (), cj % (),
        cj & (), cj | (), cj ^ (), cj << (), cj >> (),
        ck + (), ck - (), ck * (), ck ** (), ck / (), ck % (),
        ck & (), ck | (), ck ^ (), ck << (), ck >> ()
    ]
    for (result in binaryResults) {
        if (!(result is CL)) {
            return 1
        }
    }
    return 0
}
